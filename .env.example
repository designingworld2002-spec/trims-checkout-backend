# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Admin API is served from your *.myshopify.com domain (NOT your custom
# storefront domain). Find it in Shopify admin URL: admin.shopify.com/store/<handle>
# → the domain is <handle>.myshopify.com
SHOPIFY_DOMAIN=your-store.myshopify.com

# Admin API access token (Settings → Apps and sales channels → Develop apps →
# your app → API credentials). Keep it secret.
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin GraphQL API version. MUST be recent enough for `priceOverride` on
# DraftOrderLineItemInput (2025-01+). A stale value is auto-upgraded at runtime
# to a modern default, but set it explicitly to avoid the startup warning.
SHOPIFY_API_VERSION=2026-04

# Currency for money fields + presentment. India store → INR. Set
# SHOPIFY_PRESENTMENT_CURRENCY empty to omit presentmentCurrencyCode (only if
# Shopify rejects it because INR isn't an enabled presentment currency).
SHOPIFY_CURRENCY=INR
SHOPIFY_PRESENTMENT_CURRENCY=INR

PORT=3000
